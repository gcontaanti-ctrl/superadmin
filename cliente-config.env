# =============== CONFIGURACOES DO CLIENTE ===============
# Coloque o IP do servidor local onde o Banco DB2 esta instalado (Ex: 192.168.0.100 ou localhost)
DB2_HOSTNAME=192.168.20.20

# Nome de usuario do banco DB2 do cliente
DB2_UID=contabilidade

# Senha do usuario do banco DB2
DB2_PWD=}yFhZ1PuJB*[]!s

# (Opcional) Qual filial ele esta instalando? Deixe em branco para consolidar todas
SUPABASE_CONFIG_ID=default

# =============== NAO ALTERAR (PADROES) ===============
DB2_DATABASE=cisserp
DB2_PORT=30231
DB2_PROTOCOL=TCPIP
PORT=3001
