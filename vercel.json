{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "build": {
    "env": {
      "DANGEROUSLY_DEPLOY_VULNERABLE_TANSTACK_START_XSS": "1"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*superatacado.*"
        }
      ],
      "destination": "https://superatacado.cybertechapp.com.br/api/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://albuquerque.cybertechapp.com.br/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
